{
  "name": "propleads",
  "productName": "PropLeads",
  "version": "1.0.0",
  "description": "Find real estate brokers and agents by location, enrich their contact details, and run polite outreach.",
  "main": "dist-electron/main.cjs",
  "author": "PropLeads",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "node scripts/build-electron.mjs && concurrently -k -n vite,electron,main -c blue,green,magenta \"vite\" \"wait-on tcp:5173 file:dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\" \"node scripts/build-electron.mjs --watch\"",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.propleads.app",
    "productName": "PropLeads",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "mac": {
      "category": "public.app-category.business",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage"], "category": "Office" }
  }
}
